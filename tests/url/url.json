{
 "class": "url",
 "edition": "1.0-draft",
 "note": "kind data: a data: URL string; query: whole-query form; param: the jai parameter.",
 "cases": [
  {
   "id": "url-data-text",
   "rationale": "Canonical URL form.",
   "url": "data:image/jai,A%20magical%20castle;style=anime",
   "kind": "data",
   "document": {
    "prompt": [
     "A magical castle"
    ],
    "style": [
     "anime"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-raw-space",
   "rationale": "Raw spaces survive the data: URL processor in src (not in srcset).",
   "url": "data:image/jai,A magical castle;style=anime",
   "kind": "data",
   "document": {
    "prompt": [
     "A magical castle"
    ],
    "style": [
     "anime"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-base64",
   "rationale": "Base64 file form.",
