   "kind": "data",
   "document": {
    "prompt": [
     "A magical castle"
    ],
    "style": [
     "anime"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-base64-json",
   "rationale": "Base64 JSON.",
