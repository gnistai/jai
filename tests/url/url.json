{
 "class": "url",
 "edition": "1.0-draft",
 "note": "data: URL string -> document + exact parser diagnostics (the text form only), or no document.",
 "cases": [
  {
   "id": "url-data-text",
   "rationale": "Canonical URL form.",
   "url": "data:image/jai,A%20magical%20castle;style=anime",
   "document": {
    "prompt": [
     "A magical castle"
    ],
    "style": [
     "anime"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-raw-space",
   "rationale": "Raw spaces survive the data: URL processor in src (not in srcset).",
   "url": "data:image/jai,A magical castle;style=anime",
   "document": {
    "prompt": [
     "A magical castle"
    ],
    "style": [
     "anime"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-base64-text",
   "rationale": "The data: URL processor removes base64; the bytes are then read as text like any other body (validators report data-url-parameter).",
   "url": "data:image/jai;base64,QSBtYWdpY2FsIGNhc3RsZTtzdHlsZT1hbmltZQ==",
   "document": {
    "prompt": [
     "A magical castle"
    ],
    "style": [
     "anime"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-base64-gzip",
   "rationale": "A data: body holds the text form only: the bytes of a .jai file are not UTF-8 text.",
   "url": "data:image/jai;base64,H4sIAAAAAAACA6tWykrMVLIy1FEqKMrPLShRslJyVMhNTM9MTsxRSE4sLslJVdJRKi6pBNJWSol5mbmpSrUAq6nXdjUAAAA=",
   "document": {},
   "diagnostics": [
    "undecodable"
   ],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-json-is-prose",
   "rationale": "A JSON object in a data: body is prose, like anything else.",
   "url": "data:image/jai,{%22jai%22:1,%22prompt%22:%22A%20magical%20castle%22,%22style%22:%22anime%22}",
   "document": {
    "prompt": [
     "{\"jai\":1,\"prompt\":\"A magical castle\",\"style\":\"anime\"}"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-jai-colon",
   "rationale": "There is no prefix: jai: in a data: body is prose.",
   "url": "data:image/jai,jai:A%20castle",
   "document": {
    "prompt": [
     "jai:A castle"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-double-encoded",
   "rationale": "Exactly one percent-decoding.",
   "url": "data:image/jai,100%2520",
   "document": {
    "prompt": [
     "100%20"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-bare-percent",
   "rationale": "A % not followed by two hex digits is left in place.",
   "url": "data:image/jai,100% cotton",
   "document": {
    "prompt": [
     "100% cotton"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-bad-hex",
   "rationale": "%ab decodes to byte AB, which is not UTF-8 on its own; %zz is left in place. Strict UTF-8 applies.",
   "url": "data:image/jai,%ab%zz",
   "document": {},
   "diagnostics": [
    "undecodable"
   ],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-hash-truncates",
   "rationale": "An unencoded # ends the URL.",
   "url": "data:image/jai,Castle #3;style=anime",
   "document": {
    "prompt": [
     "Castle"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-hash-encoded",
   "rationale": "%23 keeps it.",
   "url": "data:image/jai,Castle%20%233;style=anime",
   "document": {
    "prompt": [
     "Castle #3"
    ],
    "style": [
     "anime"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-newline-encoded",
   "rationale": "%0A carries a line break.",
   "url": "data:image/jai,line%0Atwo",
   "document": {
    "prompt": [
     "line\ntwo"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-newline-raw",
   "rationale": "Raw line breaks are deleted by the URL parser.",
   "url": "data:image/jai,line\ntwo",
   "document": {
    "prompt": [
     "linetwo"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-escaped-semicolon-encoded",
   "rationale": "%3B and %3D become ; and = and parse as delimiters.",
   "url": "data:image/jai,a%3Bstyle%3Dx",
   "document": {
    "prompt": [
     "a"
    ],
    "style": [
     "x"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-charset-param",
   "rationale": "Media-type parameters have no meaning (validators report data-url-parameter).",
   "url": "data:image/jai;charset=utf-8,A%20castle",
   "document": {
    "prompt": [
     "A castle"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-other-type",
   "rationale": "Not image/jai: not discovered.",
   "url": "data:image/png,abc",
   "discovered": false,
   "since": "1.0-draft"
  },
  {
   "id": "url-data-missing-comma",
   "rationale": "No comma: not a data URL body.",
   "url": "data:image/jai;A castle",
   "discovered": false,
   "since": "1.0-draft"
  },
  {
   "id": "url-data-upper",
   "rationale": "Scheme and essence are case-insensitive.",
   "url": "DATA:IMAGE/JAI,A%20castle",
   "document": {
    "prompt": [
     "A castle"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-nbsp-mime",
   "rationale": "Fetch's MIME parsing: NBSP is not whitespace, so the essence is not image/jai (R2-27).",
   "url": "data:image/jai ,x",
   "discovered": false,
   "since": "1.0-draft"
  },
  {
   "id": "url-data-ff-mime",
   "rationale": "The URL parser percent-encodes FF in the path, so the essence is not image/jai (R2-27).",
   "url": "data:image/jai\f,x",
   "discovered": false,
   "since": "1.0-draft"
  },
  {
   "id": "url-data-space-mime",
   "rationale": "ASCII whitespace around the media type is stripped by Fetch.",
   "url": "data:image/jai ,x",
   "document": {
    "prompt": [
     "x"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-bad-base64",
   "rationale": "A body that forgiving-base64 rejects: no document (R2-27).",
   "url": "data:image/jai;base64,!!!!",
   "discovered": false,
   "since": "1.0-draft"
  },
  {
   "id": "url-data-base64-bad-padding",
   "rationale": "Wrong padding fails forgiving-base64: no document (R2-27).",
   "url": "data:image/jai;base64,eyJqYWkiOjEsInByb21wdCI6IngifQ=",
   "discovered": false,
   "since": "1.0-draft"
  },
  {
   "id": "url-data-nul",
   "rationale": "%00 decodes to a 00 byte, which byte input rejects (R2-25).",
   "url": "data:image/jai,A%00castle",
   "document": {},
   "diagnostics": [
    "undecodable"
   ],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-question",
   "rationale": "? is part of a data: URL body (S-8).",
   "url": "data:image/jai,What%3F%20now?;style=x",
   "document": {
    "prompt": [
     "What? now?"
    ],
    "style": [
     "x"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-tab-raw",
   "rationale": "Raw TAB is deleted by the URL parser (S-8).",
   "url": "data:image/jai,A\tcastle",
   "document": {
    "prompt": [
     "Acastle"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-trailing-comma-encoded",
   "rationale": "An encoded final comma survives (S-8).",
   "url": "data:image/jai,a%2C",
   "document": {
    "prompt": [
     "a,"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-data-slash",
   "rationale": "An encoded leading slash survives (S-8).",
   "url": "data:image/jai,%2Fimagine%20a%20cat",
   "document": {
    "prompt": [
     "/imagine a cat"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  },
  {
   "id": "url-qualified-escaped",
   "rationale": "An escaped semicolon before word/word= in a data: URL.",
   "url": "data:image/jai,A%20ratio\\;%20a/b=c",
   "document": {
    "prompt": [
     "A ratio; a/b=c"
    ]
   },
   "diagnostics": [],
   "since": "1.0-draft"
  }
 ]
}
