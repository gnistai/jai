  },
  {
   "id": "ser-prompt-bom",
   "rationale": "A U+FEFF-initial first prompt is written with prompt=, because the parser removes leading U+FEFF.",
   "document": {
    "prompt": [
     "﻿x"
    ]
   },
   "text": "prompt=﻿x",
   "json": "{\"jai\":1,\"prompt\":\"﻿x\"}",
   "identity": "f1671ee9f2a393ebeff87e3a27c5bef6e0e6dfc64cbaabde69f950c59f136f76",
   "since": "1.0-draft"
  },
  {
   "id": "ser-prompt-brace",
   "rationale": "A {-initial prompt needs no protection: nothing is sniffed for JSON.",
   "document": {
    "prompt": [
     "{x}"
    ]
   },
   "text": "{x}",
   "json": "{\"jai\":1,\"prompt\":\"{x}\"}",
   "identity": "8f7315b2802629b213dd895b25012410d3f3a7b15aa60afed9798d3f4fc54afc",
   "since": "1.0-draft"
  },
