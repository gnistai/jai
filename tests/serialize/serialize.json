{
 "class": "serialize",
 "edition": "1.0-draft",
 "note": "document -> canonical text, canonical JSON, identity (and the canonical data: URL where given).",
 "cases": [
  {
   "id": "ser-simple",
   "rationale": "Minimal.",
   "document": {
    "prompt": [
     "A magical castle"
    ]
   },
   "text": "A magical castle",
   "json": "{\"jai\":1,\"prompt\":\"A magical castle\"}",
   "identity": "444e47cb00f5fbf14f8e3d6c90e23e28d7e6012bf6ac714f0a5e7171869e364b",
   "since": "1.0-draft"
  },
  {
   "id": "ser-order",
   "rationale": "Prompt first, keys by code point, repeats adjacent.",
   "document": {
    "style": [
     "anime"
    ],
    "prompt": [
     "A castle"
    ],
    "model": [
     "flux",
     "sdxl"
    ]
   },
   "text": "A castle;model=flux;model=sdxl;style=anime",
   "json": "{\"jai\":1,\"prompt\":\"A castle\",\"model\":[\"flux\",\"sdxl\"],\"style\":\"anime\"}",
   "identity": "eb7181bb0c7dd2e1a2e23993b92bb7e46c2781f98a1ef8eb87677b15917635e9",
   "since": "1.0-draft"
  },
  {
   "id": "ser-multi-prompt",
   "rationale": "Later prompt values use prompt=.",
   "document": {
    "prompt": [
     "A castle",
     "with a moat"
    ],
    "model": [
     "flux"
    ]
   },
   "text": "A castle;prompt=with a moat;model=flux",
   "json": "{\"jai\":1,\"prompt\":[\"A castle\",\"with a moat\"],\"model\":\"flux\"}",
   "identity": "62b8f3987004754e4ac2e933b3222d2c328d6aa8fe7a91cb60f56cf828ba1310",
   "since": "1.0-draft"
  },
  {
   "id": "ser-prose-semicolon",
   "rationale": "Ordinary prose semicolons are not escaped.",
   "document": {
    "prompt": [
     "A wizard stands; behind him, a dragon"
    ],
    "model": [
     "flux"
    ]
   },
   "text": "A wizard stands; behind him, a dragon;model=flux",
   "json": "{\"jai\":1,\"prompt\":\"A wizard stands; behind him, a dragon\",\"model\":\"flux\"}",
   "identity": "dc3657d2e97402c4cdaba90281eff686314e04b35ba06df511d9d374920f95f7",
   "since": "1.0-draft"
  },
  {
   "id": "ser-leading-word-eq",
   "rationale": "A leading word= forces prompt=.",
   "document": {
    "prompt": [
     "E=mc2 explained"
    ]
   },
   "text": "prompt=E=mc2 explained",
   "json": "{\"jai\":1,\"prompt\":\"E=mc2 explained\"}",
   "identity": "4ac54a18ba981c5940c985f4eb9f53882e66d6a6611b24a36a85ffc67c6699e8",
   "since": "1.0-draft"
  },
  {
   "id": "ser-leading-semicolon",
   "rationale": "A leading ; is escaped.",
   "document": {
    "prompt": [
     ";-) a smiley"
    ]
   },
   "text": "\\;-) a smiley",
   "json": "{\"jai\":1,\"prompt\":\";-) a smiley\"}",
   "identity": "dac83a169af9250f090819b6a6f00567f38ac28d5fa1c43244cbd99fc3854509",
   "since": "1.0-draft"
  },
  {
   "id": "ser-trailing-backslash",
   "rationale": "A trailing backslash is escaped.",
   "document": {
    "prompt": [
     "ends with backslash\\"
    ],
    "style": [
     "x"
    ]
   },
   "text": "ends with backslash\\\\;style=x",
   "json": "{\"jai\":1,\"prompt\":\"ends with backslash\\\\\",\"style\":\"x\"}",
   "identity": "03350ba92b1333ef612c888ff3cbf29e135a7d380926e5e34ec95247941b621b",
   "since": "1.0-draft"
  },
  {
   "id": "ser-trailing-backslash-last",
   "rationale": "Also at the end of the document (later concatenation).",
   "document": {
    "prompt": [
     "x"
    ],
    "style": [
     "C:\\dir\\"
    ]
   },
   "text": "x;style=C:\\dir\\\\",
   "json": "{\"jai\":1,\"prompt\":\"x\",\"style\":\"C:\\\\dir\\\\\"}",
   "identity": "253523aa0122dcf90910ace568033736a84583a27ee1b4b4d6e3354a8bba4ecf",
   "since": "1.0-draft"
  },
  {
   "id": "ser-double-semicolon",
   "rationale": "; followed by ; is escaped.",
   "document": {
    "prompt": [
     "a;;b"
    ]
   },
   "text": "a\\;;b",
   "json": "{\"jai\":1,\"prompt\":\"a;;b\"}",
   "identity": "76fe5004806fefbb4fd47170c80fdb4070ba849a9e373b9362430b7a86943d8e",
   "since": "1.0-draft"
  },
  {
   "id": "ser-semicolon-ws-semicolon",
   "rationale": "; followed by whitespace then ;.",
   "document": {
    "prompt": [
     "a; ;b"
    ]
   },
   "text": "a\\; ;b",
   "json": "{\"jai\":1,\"prompt\":\"a; ;b\"}",
   "identity": "1903195e5ac89dd39c6e67a0399b8fe0d58d495a78c68081b255fbe91676fbba",
   "since": "1.0-draft"
  },
  {
   "id": "ser-semicolon-end",
   "rationale": "; at end of value.",
   "document": {
    "prompt": [
     "a;"
    ],
    "style": [
     "x"
    ]
   },
   "text": "a\\;;style=x",
   "json": "{\"jai\":1,\"prompt\":\"a;\",\"style\":\"x\"}",
   "identity": "17a4eea8f35083669eeff08137cea991076e8e73bfd42f5c5745b9c9d3c54baf",
   "since": "1.0-draft"
  },
  {
   "id": "ser-semicolon-key-eq",
   "rationale": "; followed by key=.",
   "document": {
    "prompt": [
     "A list; item=1"
    ]
   },
   "text": "A list\\; item=1",
   "json": "{\"jai\":1,\"prompt\":\"A list; item=1\"}",
   "identity": "1a2ef29cedd395687a08e928e0b6ebda5bb17a5fbdd105c5e27baf6deaf960be",
   "since": "1.0-draft"
  },
  {
   "id": "ser-semicolon-key-ws-eq",
   "rationale": "; followed by key OWS = (case-insensitive key).",
   "document": {
    "prompt": [
     "A list; Item = 1"
    ]
   },
   "text": "A list\\; Item = 1",
   "json": "{\"jai\":1,\"prompt\":\"A list; Item = 1\"}",
   "identity": "671dfe6bf25a14650c4acdb54d529c80ed24148cdf71670bf7a18a3a17be85ff",
   "since": "1.0-draft"
  },
  {
   "id": "ser-semicolon-nbsp-key",
   "rationale": "The whitespace class in the regex is JAI whitespace.",
   "document": {
    "prompt": [
     "a; b=c"
    ]
   },
   "text": "a\\; b=c",
   "json": "{\"jai\":1,\"prompt\":\"a; b=c\"}",
   "identity": "06348f3d5063a1bda3678856a25db2a792ab5cf25f99c170164946036fa39606",
   "since": "1.0-draft"
  },
  {
   "id": "ser-windows-path",
   "rationale": "Other backslashes are not escaped.",
   "document": {
    "prompt": [
     "C:\\Users\\me"
    ]
   },
   "text": "C:\\Users\\me",
   "json": "{\"jai\":1,\"prompt\":\"C:\\\\Users\\\\me\"}",
   "identity": "aab498db5219807ea383bc611dbd1363b00ade1eb5066fc351e3f782b5b5f4be",
   "since": "1.0-draft"
  },
  {
   "id": "ser-backslash-semicolon-value",
   "rationale": "Backslash before ; is escaped; the ; itself is followed by b.",
   "document": {
    "prompt": [
     "a\\;b"
    ]
   },
   "text": "a\\\\;b",
   "json": "{\"jai\":1,\"prompt\":\"a\\\\;b\"}",
   "identity": "2c6d560dfa9cc2e25622ca838719b086716f27360d36e53830dece840b974c49",
   "since": "1.0-draft"
  },
  {
   "id": "ser-backslash-equals",
   "rationale": "Backslash before = is escaped.",
   "document": {
    "prompt": [
     "x"
    ],
    "acme.v": [
     "a\\=b"
    ]
   },
   "text": "x;acme.v=a\\\\=b",
   "json": "{\"jai\":1,\"prompt\":\"x\",\"acme.v\":\"a\\\\=b\"}",
   "identity": "e8403ed6d4179a8b2d156cdf04e47b3544d9f4f5603b993ea26c6dd3b58e162e",
   "since": "1.0-draft"
  },
  {
   "id": "ser-double-backslash",
   "rationale": "Only a backslash followed by a significant character is escaped; the second one precedes b.",
   "document": {
    "prompt": [
     "a\\\\b"
    ]
   },
   "text": "a\\\\\\b",
   "json": "{\"jai\":1,\"prompt\":\"a\\\\\\\\b\"}",
   "identity": "78551737ce66b3e6e9c53843f77c9b63adfb03c139f64ce58b610d0b0313fba7",
   "since": "1.0-draft"
  },
  {
   "id": "ser-equals-not-escaped",
   "rationale": "= is never escaped.",
   "document": {
    "prompt": [
     "x"
    ],
    "acme.formula": [
     "E=mc2"
    ]
   },
   "text": "x;acme.formula=E=mc2",
   "json": "{\"jai\":1,\"prompt\":\"x\",\"acme.formula\":\"E=mc2\"}",
   "identity": "2ee08eba57f2ffd259e8ae53f31247a34c31b01b65ac59ee39283d13510ca9e5",
   "since": "1.0-draft"
  },
