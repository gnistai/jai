     "JAI:y"
    ]
   },
   "since": "1.0-draft"
  },
  {
   "id": "rt-brace",
   "rationale": "A prompt that looks like JSON.",
   "document": {
    "prompt": [
     "{\"jai\":1}"
    ]
   },
   "since": "1.0-draft"
  },
  {
   "id": "rt-data-uris",
