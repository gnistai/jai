    "prompt": [
     ";e"
    ]
   },
   "since": "1.0-draft"
  },
  {
   "id": "rt-fuzz-class-b",
   "rationale": "Round-0 fuzzer class B: trailing backslash.",
   "document": {
    "km": [
     "\\",
     "_"
    ]
   },
   "since": "1.0-draft"
  },
  {
   "id": "rt-fuzz-class-b2",
   "rationale": "Class B in prompt values.",
   "document": {
    "prompt": [
     "\\",
     ">"
    ]
   },
   "since": "1.0-draft"
  },
  {
   "id": "rt-semicolons",
   "rationale": "Runs of semicolons.",
   "document": {
    "prompt": [
