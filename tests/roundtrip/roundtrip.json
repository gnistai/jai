    "k": [
     "a; style=anime",
     "b;\tmode =keep"
    ]
   },
   "since": "1.0-draft"
  },
  {
   "id": "rt-prefix-like",
   "rationale": "jai:-initial values.",
   "document": {
    "prompt": [
