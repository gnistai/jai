   "discovered": [],
   "since": "1.0-draft"
  },
  {
   "id": "html-picture-unencoded-space",
   "rationale": "An unencoded space makes the rest of the attribute a descriptor; castle is not a valid descriptor, so HTML drops the candidate and the source is skipped (R2-7).",
