   "discovered": [],
   "since": "1.0-draft"
  },
  {
   "id": "html-alt-plain",
   "rationale": "An ordinary alt is never JAI.",
   "html": "<img src=\"castle.png\" alt=\"A magical castle\">",
   "discovered": [],
   "since": "1.0-draft"
  },
  {
   "id": "html-alt-jai-word",
   "rationale": "Only the exact prefix counts.",
   "html": "<img src=\"castle.png\" alt=\"Jaipur at night\">",
   "discovered": [],
   "since": "1.0-draft"
  },
  {
   "id": "html-order-picture-wins",
   "rationale": "Carrier 1 before 2; alt is ignored.",
