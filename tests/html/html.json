{
 "class": "html",
 "edition": "1.0-draft",
 "note": "HTML fragment -> discovered carriers in tree order. url entries are resolved by the viewer, not decoded here.",
 "cases": [
  {
   "id": "html-picture-data",
   "rationale": "Carrier 1 with a data: URL.",
   "html": "<picture><source type=\"image/jai\" srcset=\"data:image/jai,A%20magical%20castle;style=anime\"><img src=\"castle.png\" alt=\"A castle\"></picture>",
   "discovered": [
    {
     "carrier": 1,
     "document": {
      "prompt": [
       "A magical castle"
      ],
      "style": [
       "anime"
      ]
     },
     "diagnostics": []
    }
   ],
   "since": "1.0-draft"
  },
  {
   "id": "html-picture-url",
   "rationale": "Carrier 1 with a resource URL (fetched by the viewer).",
