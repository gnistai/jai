  {
   "id": "html-src-jai-scheme",
   "rationale": "jai: in src is not a carrier.",
   "html": "<img src=\"jai:A castle\" alt=\"A castle\">",
   "discovered": [],
   "since": "1.0-draft"
  },
  {
   "id": "html-alt",
   "rationale": "alt is never a carrier, even when it begins with jai: (it is the screen-reader text).",
