   "discovered": [
    {
     "carrier": 2,
     "document": {
      "prompt": [
       "fallback"
      ]
     },
     "diagnostics": []
    }
   ],
   "advisories": [
    "srcset-unparseable"
   ],
   "since": "1.0-draft"
  },
  {
