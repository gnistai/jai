   "discovered": [
    {
     "carrier": 1,
     "document": {
      "prompt": [
       "one"
      ]
     },
     "diagnostics": []
    }
   ],
   "since": "1.0-draft"
  },
  {
   "id": "html-order-data-jai-before-alt",
   "rationale": "data-jai is the carrier; its alt is plain text, taken literally as the first prompt line.",
